# ============================================================
# Foundry-in-a-Day Workshop — 環境変数サンプル
# このファイルをコピーして .env を作成してください:
#   PowerShell: Copy-Item .env.example .env
#   Bash:       cp .env.example .env
# .env は .gitignore 済 — secrets を絶対にコミットしないこと
# ============================================================
# ============================================================
# Foundry-in-a-Day Workshop — Environment variable example
# Copy this file to create .env:
#   PowerShell: Copy-Item .env.example .env
#   Bash:       cp .env.example .env
# .env is already listed in .gitignore — never commit secrets
# ============================================================

# --- Microsoft Foundry プロジェクト ---
# --- Microsoft Foundry project ---
FOUNDRY_PROJECT_ENDPOINT=https://<account>.services.ai.azure.com/api/projects/<project>
AZURE_AI_MODEL_DEPLOYMENT_NAME=gpt-4o

# --- Azure 認証 (DefaultAzureCredential 用 / 必要に応じて) ---
# --- Azure authentication (for DefaultAzureCredential / as needed) ---
AZURE_TENANT_ID=
AZURE_SUBSCRIPTION_ID=

# --- Lab 個別の追加変数は各 Lab README を参照 ---
# --- See each lab README for additional lab-specific variables ---
