# ====== Microsoft Foundry プロジェクト ======
# 例: https://<account>.services.ai.azure.com/api/projects/<project>
# ====== Microsoft Foundry project ======
# Example: https://<account>.services.ai.azure.com/api/projects/<project>
FOUNDRY_PROJECT_ENDPOINT=

# オーケストレータが使う LLM のモデルデプロイ名 (Foundry プロジェクトに作成済みのものを指定)
# 例: gpt-5.2
# LLM model deployment name used by the orchestrator (specify one created in the Foundry project)
# Example: gpt-5.2
AZURE_AI_MODEL_DEPLOYMENT_NAME=
